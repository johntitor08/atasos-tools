#!/bin/bash
# atasOS guncelleme denetleyicisi (atasos-guncelleme 1.6). Kullanici olarak calisir, ROOT GEREKMEZ, hicbir sey KURMAZ.
#   - imzali paket dizinini ~/.cache/atasos-guncelleme'ye indirir ve depo anahtariyla dogrular (gpgv)
#   - kurulu paketlerle karsilastirir: yeni surumu olanlar + temel.list'te olup henuz kurulmamislar
#   - guncelleme varsa KDE bildirimi gosterir; "Simdi guncelle" dugmesi "Sistemi Guncelle"yi acar
# Kullanim:
#   atasos-guncelleme-denetle             bir kez denetle, sonucu yaz (bildirim yok)
#   atasos-guncelleme-denetle --bildir    bir kez denetle, guncelleme varsa bildirim goster
#   atasos-guncelleme-denetle --arkaplan  oturum acilisindan 5 dk sonra ve sonra 24 saatte bir --bildir
#                                         (/etc/xdg/autostart/atasos-guncelleme-denetle.desktop bunu baslatir)
# Kapatmak: ~/.config/atasos-guncelleme-denetle-kapali dosyasini olustur.
set -uo pipefail
export LC_ALL=C.UTF-8
DB=/var/lib/atspkg/db
ANAHTAR=/usr/share/atspkg/depo-anahtari.gpg
LISTE=/usr/share/atasos-guncelleme/temel.list
DEPO=$(sed -n 's/^DEPO=//p' /etc/atspkg/atspkg.conf 2>/dev/null | tail -n1); DEPO=${DEPO:-https://archive.org/download/atasos-depo}
ON=${XDG_CACHE_HOME:-$HOME/.cache}/atasos-guncelleme
KAPALI=${XDG_CONFIG_HOME:-$HOME/.config}/atasos-guncelleme-denetle-kapali

kurulu(){ [ -f "$DB/$1/PKGINFO" ] && awk -F' = ' '$1=="version"{v=$2} $1=="release"{r=$2} END{print v"-"r}' "$DB/$1/PKGINFO"; }
dizinde(){ awk -v n="$1" '$1==n{print $2"-"$3}' "$ON/atspkg.index" | sort -V | tail -n1; }
yeni_mi(){ [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$2" ]; }

# denetle: GUNCELLEMELER dizisini doldurur ("ad eski -> yeni"); 0 = denetlendi, 1 = dizin alinamadi/dogrulanamadi
denetle() {
    GUNCELLEMELER=()
    mkdir -p "$ON" || return 1
    curl -fsSL --max-time 60 -o "$ON/atspkg.index.yeni" "$DEPO/atspkg.index" \
        && curl -fsSL --max-time 60 -o "$ON/atspkg.index.sig.yeni" "$DEPO/atspkg.index.sig" || return 1
    gpgv --keyring "$ANAHTAR" "$ON/atspkg.index.sig.yeni" "$ON/atspkg.index.yeni" >/dev/null 2>&1 || return 1
    mv -f "$ON/atspkg.index.yeni" "$ON/atspkg.index"; mv -f "$ON/atspkg.index.sig.yeni" "$ON/atspkg.index.sig"
    local ad k d
    for ad in $(awk '{print $1}' "$ON/atspkg.index" | sort -u); do
        d=$(dizinde "$ad"); k=$(kurulu "$ad")
        if [ -n "$k" ]; then
            yeni_mi "$k" "$d" && GUNCELLEMELER+=("$ad $k -> $d")
        elif [ -f "$LISTE" ] && grep -qx "$ad" "$LISTE"; then
            GUNCELLEMELER+=("$ad (yeni) -> $d")
        fi
    done
    return 0
}

canli_mi(){ [ -x /usr/bin/calamares ] && [ -e /usr/share/applications/calamares.desktop ]; }

bildir() {
    local n=${#GUNCELLEMELER[@]} adlar govde id
    adlar=$(printf '%s\n' "${GUNCELLEMELER[@]}" | awk '{print $1}' | head -n 6 | paste -sd, - | sed 's/,/, /g')
    [ "$n" -gt 6 ] && adlar="$adlar …"
    govde="$n paket güncellenebilir: $adlar"
    id=$(gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications \
        --method org.freedesktop.Notifications.Notify "atasOS" 0 "system-software-update" "Güncellemeler var" "$govde" \
        '["guncelle", "Şimdi güncelle"]' '{"desktop-entry": <"atasos-guncelle">, "urgency": <byte 1>}' 0 2>/dev/null \
        | sed -n 's/.*uint32 \([0-9][0-9]*\).*/\1/p' | head -n1) || return 0   # yanit: "(uint32 5,)"
    [ -n "$id" ] || return 0
    # dugmeye basilirsa Sistemi Guncelle'yi ac; bildirim kapanirsa ya da 6 saat gecerse birak
    timeout 21600 gdbus monitor --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications 2>/dev/null \
    | while read -r satir; do
        case "$satir" in
            # LC_ALL bu betikte C.UTF-8; Konsole kullanicinin dilinde (Turkce) acilsin diye ortamdan cikarilir
            *"ActionInvoked (uint32 $id, 'guncelle')"*) env -u LC_ALL setsid -f konsole --hold -e /usr/bin/atasos-guncelle >/dev/null 2>&1; break ;;
            *"NotificationClosed (uint32 $id,"*) break ;;
        esac
    done
}

# Ctrl+C / sonlandirma: bekleyen gdbus monitor dahil tum alt surecleri kapat
trap 'trap - INT TERM; kill 0 2>/dev/null; exit 130' INT TERM

case "${1:-}" in
    --arkaplan)
        canli_mi && exit 0
        sleep 300
        while :; do
            if [ ! -e "$KAPALI" ] && denetle && [ ${#GUNCELLEMELER[@]} -gt 0 ]; then bildir; fi
            sleep 86400
        done ;;
    --bildir)
        denetle || { echo "paket dizini alinamadi ya da imzasi dogrulanamadi"; exit 1; }
        [ ${#GUNCELLEMELER[@]} -gt 0 ] && bildir; printf '%s\n' "${GUNCELLEMELER[@]}" ;;
    "")
        denetle || { echo "paket dizini alinamadi ya da imzasi dogrulanamadi"; exit 1; }
        if [ ${#GUNCELLEMELER[@]} -eq 0 ]; then echo "sistem guncel"
        else echo "${#GUNCELLEMELER[@]} guncelleme:"; printf '  %s\n' "${GUNCELLEMELER[@]}"; fi ;;
    *) echo "kullanim: atasos-guncelleme-denetle [--bildir|--arkaplan]" >&2; exit 1 ;;
esac

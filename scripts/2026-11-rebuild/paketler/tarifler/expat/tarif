# atasOS tarifi: expat (XML ayristirici; v36'da 2.7.1). Ozgun: /usr/lib, statik kutuphane yok, cmake dosyalari /usr/lib/cmake.
# SONAME libexpat.so.1 degismez; eski libexpat.so.1.10.2 dosyasi diskte kalir ama baglanti yenisine gider.
name=expat
version=2.10.0
release=1
description="expat XML ayristirici kutuphanesi - guvenlik guncellemesi"
depends=()
source=(expat-2.10.0.tar.xz)

build() {
    ./configure --prefix=/usr --disable-static --docdir=/usr/share/doc/expat-2.10.0
    make -j"$(nproc)"
    make DESTDIR="$pkgdir" install
    rm -f "$pkgdir"/usr/lib/libexpat.la
    [ -f "$pkgdir/usr/lib/libexpat.so.1" ] || { echo "libexpat.so.1 /usr/lib altinda degil"; exit 1; }
}

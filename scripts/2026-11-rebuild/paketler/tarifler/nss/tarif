# atasOS tarifi: NSS 3.108 (BLFS 12.3). Firefox kendi icindeki NSS'i kullaniyor; bu sistem NSS'i Electron
# uygulamalari (Claude Desktop) ve NetworkManager icin.
# - sqlite paketinden SONRA derlenir: NSS_USE_SYSTEM_SQLITE=1 -> libsoftokn3 NEEDED=libsqlite3.so.0
#   (gomulu sqlite kullanilirsa /usr/lib/libsqlite3.so'yu ezer ve "no version information" uyarisi cikar)
# - nss-standalone-1.patch: nss-config ve nss.pc uretir (BLFS)
# - .chk dosyalari (FIPS imzalari) derlemede uretilir, pakete girmeli
name=nss
version=3.108
release=1
description="Network Security Services (TLS/sertifika kutuphaneleri)"
depends=(nspr sqlite)
source=(nss-3.108.tar.gz nss-standalone-1.patch)

build() {
    cd "$srcdir/nss-3.108"
    patch -Np1 -i "$srcdir/nss-standalone-1.patch"
    cd nss
    # NSS make'i paralel derlemede guvenilir degil; seri.
    make BUILD_OPT=1 NSPR_INCLUDE_DIR=/usr/include/nspr USE_SYSTEM_ZLIB=1 ZLIB_LIBS=-lz \
         NSS_ENABLE_WERROR=0 USE_64=1 NSS_USE_SYSTEM_SQLITE=1 NSS_DISABLE_GTESTS=1
    cd ../dist
    install -d "$pkgdir"/usr/{lib/pkgconfig,bin,include/nss}
    install -m755 Linux*/lib/*.so "$pkgdir/usr/lib/"
    install -m644 Linux*/lib/*.chk Linux*/lib/libcrmf.a "$pkgdir/usr/lib/"
    cp -RL public/nss/* private/nss/* "$pkgdir/usr/include/nss/"
    install -m755 Linux*/bin/certutil Linux*/bin/nss-config Linux*/bin/pk12util "$pkgdir/usr/bin/"
    install -m644 Linux*/lib/pkgconfig/nss.pc "$pkgdir/usr/lib/pkgconfig/"
    # test modulleri sisteme girmesin
    rm -f "$pkgdir"/usr/lib/libpkcs11testmodule.so "$pkgdir"/usr/lib/libnssckbi-testlib.so
    [ ! -e "$pkgdir/usr/lib/libsqlite3.so" ] || { echo "gomulu sqlite pakete girdi"; exit 1; }
    readelf -d "$pkgdir/usr/lib/libsoftokn3.so" | grep -q 'NEEDED.*libsqlite3\.so\.0' \
        || { echo "libsoftokn3 sistem sqlite'ina (libsqlite3.so.0) bagli degil"; exit 1; }
    [ -f "$pkgdir/usr/lib/libsoftokn3.chk" ] || { echo "libsoftokn3.chk yok"; exit 1; }
}

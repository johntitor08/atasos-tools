# atasOS tarifi: OpenSSL 3.5 LTS guvenlik guncellemesi (v36'da 3.5.2).
# Ozgun derleme: varsayilan libdir (lib64), ENGINESDIR /usr/lib64/engines-3, zlib (paylasimli degil), OPENSSLDIR /etc/ssl.
# atasOS'ta kutuphanelerin OZDES bir kopyasi /usr/lib'de de var ve ld.so once onu buluyor -> ikisi birden guncellenir.
# Yapilandirma dosyalari (/etc/ssl/openssl.cnf) pakete GIRMEZ (install_sw yalniz program + kutuphane).
name=openssl
version=3.5.9
release=1
description="OpenSSL 3.5 LTS (TLS/kripto kutuphanesi) - guvenlik guncellemesi"
depends=()
source=(openssl-3.5.9.tar.gz)

build() {
    ./config --prefix=/usr --openssldir=/etc/ssl shared zlib
    make -j"$(nproc)"
    make DESTDIR="$pkgdir" install_sw
    cd "$pkgdir/usr"
    [ -f lib64/libcrypto.so.3 ] && [ -f lib64/libssl.so.3 ] || { echo "lib64 altinda libcrypto/libssl yok"; exit 1; }
    mkdir -p lib/engines-3 lib/ossl-modules lib/pkgconfig
    cp -a lib64/libcrypto.so* lib64/libssl.so* lib64/libcrypto.a lib64/libssl.a lib/
    cp -a lib64/engines-3/. lib/engines-3/
    cp -a lib64/ossl-modules/. lib/ossl-modules/
    for pc in lib64/pkgconfig/*.pc; do
        sed 's|/lib64$|/lib|; s|^libdir=\${exec_prefix}/lib64|libdir=${exec_prefix}/lib|' "$pc" > "lib/pkgconfig/${pc##*/}"
    done
}

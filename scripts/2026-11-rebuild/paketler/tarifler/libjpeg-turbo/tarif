# atasOS tarifi: libjpeg-turbo 3.2.1 (p5/v38'de 3.0.4). Kanala ILK kez giriyor.
# p5'teki ABI birebir: libjpeg.so.62 (jpeg6b ABI; WITH_JPEG8 KAPALI) + libturbojpeg.so.0, /usr/lib, statik .a de var.
# JPEG cozen her sey buna bagli (Qt/KDE resimleri, gdk-pixbuf, Firefox degil - o kendi icinde).
name=libjpeg-turbo
version=3.2.1
release=1
description="libjpeg-turbo JPEG kutuphanesi - guvenlik guncellemesi"
depends=()
source=(libjpeg-turbo-3.2.1.tar.gz)

abi_denetle() {
    # ABI denetimi: sistemdeki eski kutuphanenin disa acik sembollerinden biri bile yenisinde yoksa DUR. $1=dizin $2=ad
    eski=$(readlink -f "$1/$2" 2>/dev/null); yeni=$(readlink -f "$pkgdir$1/$2")
    [ -f "$yeni" ] || { echo "ABI: $pkgdir$1/$2 yok"; exit 1; }
    if [ -f "$eski" ]; then
        eksik=$(comm -23 <(nm -D --defined-only "$eski" | awk '{print $3}' | sort -u) <(nm -D --defined-only "$yeni" | awk '{print $3}' | sort -u))
        [ -z "$eksik" ] || { echo "ABI: yeni $2 su sembolleri vermiyor:"; echo "$eksik" | head; exit 1; }
        echo "ABI: $2 eski surumun tum sembollerini veriyor"
    fi
}

build() {
    cmake -B build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release -D CMAKE_INSTALL_DEFAULT_LIBDIR=lib \
        -D CMAKE_SKIP_INSTALL_RPATH=ON -D WITH_JPEG8=OFF -D WITH_JAVA=OFF \
        -D CMAKE_INSTALL_DOCDIR=/usr/share/doc/libjpeg-turbo-3.2.1
    cmake --build build -j"$(nproc)"
    DESTDIR="$pkgdir" cmake --install build
    readelf -d "$pkgdir/usr/lib/libjpeg.so.62" | grep -q 'SONAME.*libjpeg\.so\.62' || { echo "libjpeg SONAME libjpeg.so.62 degil"; exit 1; }
    abi_denetle /usr/lib libjpeg.so.62
    abi_denetle /usr/lib libturbojpeg.so.0
}

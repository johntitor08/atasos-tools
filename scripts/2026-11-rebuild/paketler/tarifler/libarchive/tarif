# atasOS tarifi: libarchive 3.8.11 (v36'da 3.8.1; libarchive.so.13). bsdtar/bsdcpio/bsdcat/bsdunzip dahil.
# p5'teki gibi: OpenSSL, ACL, zstd, lz4, bzip2, zlib, xz, libxml2 destekli (configure kendisi bulur; asagida denetlenir).
name=libarchive
version=3.8.11
release=1
description="libarchive arsiv kutuphanesi ve bsdtar - guvenlik guncellemesi"
depends=()
source=(libarchive-3.8.11.tar.xz)

abi_denetle() {
    # ABI denetimi: sistemdeki eski kutuphanenin disa acik sembollerinden biri bile yenisinde yoksa DUR
    eski=$(readlink -f /usr/lib/$1 2>/dev/null); yeni=$(readlink -f "$pkgdir/usr/lib/$1")
    if [ -f "$eski" ]; then
        eksik=$(comm -23 <(nm -D --defined-only "$eski" | awk '{print $3}' | sort -u) <(nm -D --defined-only "$yeni" | awk '{print $3}' | sort -u))
        [ -z "$eksik" ] || { echo "ABI: yeni $1 su sembolleri vermiyor:"; echo "$eksik" | head; exit 1; }
        echo "ABI: $1 eski surumun tum sembollerini veriyor"
    fi
}

build() {
    export PKG_CONFIG_PATH=/usr/lib64/pkgconfig:/usr/lib/pkgconfig:/usr/share/pkgconfig
    ./configure --prefix=/usr --disable-static
    make -j"$(nproc)"
    make DESTDIR="$pkgdir" install
    rm -f "$pkgdir"/usr/lib/libarchive.la
    [ -f "$pkgdir/usr/lib/libarchive.so.13" ] || { echo "libarchive.so.13 /usr/lib altinda degil"; exit 1; }
    for l in libcrypto libacl libzstd liblz4 libbz2 libz liblzma libxml2; do
        readelf -d "$pkgdir/usr/lib/libarchive.so.13" | grep -q "NEEDED.*$l\." || { echo "libarchive $l olmadan derlendi (p5'teki ile ayni degil)"; exit 1; }
    done
    abi_denetle libarchive.so.13
}

# atasOS tarifi: libxml2 2.13.9 (v36'da 2.13.5; ayni 2.13 serisi = ayni ABI, libxml2.so.2).
# p5'teki ozellikler birebir: zlib/lzma/ICU/HTTP/FTP/Python KAPALI, readline (xmllint --shell) ACIK.
name=libxml2
version=2.13.9
release=1
description="libxml2 XML ayristirici kutuphanesi - guvenlik guncellemesi"
depends=()
source=(libxml2-2.13.9.tar.xz)

abi_denetle() {
    # ABI denetimi: sistemdeki eski kutuphanenin disa acik sembollerinden biri bile yenisinde yoksa DUR
    eski=$(readlink -f /usr/lib/$1 2>/dev/null); yeni=$(readlink -f "$pkgdir/usr/lib/$1")
    if [ -f "$eski" ]; then
        eksik=$(comm -23 <(nm -D --defined-only "$eski" | awk '{print $3}' | sort -u) <(nm -D --defined-only "$yeni" | awk '{print $3}' | sort -u))
        [ -z "$eksik" ] || { echo "ABI: yeni $1 su sembolleri vermiyor:"; echo "$eksik" | head; exit 1; }
        echo "ABI: $1 eski surumun tum sembollerini veriyor"
    fi
}

build() {
    export PKG_CONFIG_PATH=/usr/lib64/pkgconfig:/usr/lib/pkgconfig:/usr/share/pkgconfig
    ./configure --prefix=/usr --sysconfdir=/etc --disable-static --with-history --without-python \
        --without-zlib --without-lzma --without-icu --without-http --without-ftp \
        --docdir=/usr/share/doc/libxml2-2.13.9
    make -j"$(nproc)"
    make DESTDIR="$pkgdir" install
    rm -f "$pkgdir"/usr/lib/libxml2.la
    [ -f "$pkgdir/usr/lib/libxml2.so.2" ] || { echo "libxml2.so.2 /usr/lib altinda degil"; exit 1; }
    abi_denetle libxml2.so.2
}

# atasOS kernel config fragment: atas6 -> atas7
# Taban: /boot/config-6.16.1-atas6 (Linux 6.16.1)
#
# Kullanım (kernel kaynak dizininde):
#   cp /boot/config-6.16.1-atas6 .config
#   scripts/kconfig/merge_config.sh -m .config /yol/atas7.config
#   make olddefconfig
# merge_config.sh, son .config'e giremeyen her satır için
# "Value requested for CONFIG_X not in final .config" uyarısı basar.

CONFIG_LOCALVERSION="-atas7"

# --- cgroup / systemd ---------------------------------------------------
# systemd'nin MemoryMax= vb. limitleri, systemd-oomd ve konteynerler için.
CONFIG_MEMCG=y
# systemd-oomd PSI'ya da ihtiyaç duyar.
CONFIG_PSI=y
# Masaüstü tepkiselliği: terminalden başlatılan ağır işler arayüzü boğmasın.
CONFIG_SCHED_AUTOGROUP=y

# --- BPF ----------------------------------------------------------------
# systemd IPAddressAllow/Deny, IP accounting, RestrictFileSystems vb.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_CGROUP_BPF=y

# --- nftables -----------------------------------------------------------
# Eski iptables yerinde kalıyor; nft yanına modül olarak ekleniyor.
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_COMPAT=m

# --- VPN ----------------------------------------------------------------
CONFIG_WIREGUARD=m

# --- Bellek -------------------------------------------------------------
# MGLRU: bellek baskısı altında daha akıcı bir masaüstü.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# THP yalnızca madvise ile isteyen programlara (tarayıcılar, JVM vb.).
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# zram-swap için zstd (lzo-rle'den belirgin şekilde daha iyi sıkıştırır).
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# --- Güvenlik -----------------------------------------------------------
# /sys/kernel/security/lsm vb. için.
CONFIG_SECURITYFS=y
# Hafif LSM'ler; politika dosyası gerektirmezler.
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
# Sadece gerçekten derlenen LSM'leri listele.
CONFIG_LSM="landlock,lockdown,yama,selinux"

# --- CPU frekansı -------------------------------------------------------
# intel_pstate aktif modda bunu yok sayar; passive moda/acpi-cpufreq'e
# düşülürse "userspace" yerine mantıklı bir varsayılan olur.
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# --- Açılış -------------------------------------------------------------
# gzip yerine zstd: daha hızlı açılır, benzer boyut.
CONFIG_KERNEL_ZSTD=y

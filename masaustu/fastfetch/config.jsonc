// atasOS: fastfetch sistem geneli ayari (/etc/xdg/fastfetch/config.jsonc).
// Kullanici kendi ~/.config/fastfetch/config.jsonc dosyasini olusturursa bu dosya yok sayilir.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/atasos/fastfetch/atasos.txt",
        "color": { "1": "blue", "2": "white" },
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "color": { "keys": "blue", "title": "blue" }
    },
    // fastfetch'in varsayilan modulleri (ayar dosyasinda liste yoksa hicbir bilgi yazilmaz)
    "modules": [
        "title", "separator", "os", "host", "kernel", "uptime", "packages", "shell", "display", "de", "wm",
        "wmtheme", "theme", "icons", "font", "cursor", "terminal", "terminalfont", "cpu", "gpu", "memory",
        "swap", "disk", "localip", "battery", "poweradapter", "locale", "break", "colors"
    ]
}
